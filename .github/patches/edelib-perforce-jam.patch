diff --git a/Jamrules b/Jamrules
index 228203b..e0fd5cc 100644
--- a/Jamrules
+++ b/Jamrules
@@ -120,10 +120,15 @@ rule MakeLibrary
 {
 	local path = [ FFileName $(TOP) $(EDELIB_LIBDIR) $(1) ] ;
 
+	# Perforce Jam's Library/SharedLibrary keep the name they are given and
+	# do not add SOURCE_GRIST. Install* looks the product up with FGristFiles,
+	# so the built target has to carry that grist or `jam install` cannot make it.
+	local built = [ FGristFiles $(path) ] ;
+
 	if $(SHARED) = 1 {
-		SharedLibrary $(path) : $(2) ;
+		SharedLibrary $(built) : $(2) ;
 	} else {
-		Library $(path) : $(2) ;
+		Library $(built) : $(2) ;
 	}
 
 	if $(3) != "noinstall" {
@@ -248,33 +253,36 @@ rule SharedObjects
 rule MakeTest
 {
 	local lpath ;
+	# Same grist InstallProgram applies, so `jam install` builds the tool
+	# instead of looking for a target Perforce Jam never defined.
+	local target = [ FGristFiles $(1) ] ;
 
 	lpath = [ FDirName $(TOP)/$(EDELIB_LIBDIR) ] ;
 
-	Main $(1) : $(2) ;
+	Main $(target) : $(2) ;
 
 	if $(SHARED) = 1 {
 		if $(OS) = "SOLARIS" {
 			# network libraries are in libxnet
-			LinkAgainst $(1) : -lxnet ;
+			LinkAgainst $(target) : -lxnet ;
 		}
 	}
 
 	if $(4) = "use-dbus" && $(DBUS_CFLAGS) {
 		if $(SHARED) = 1 { 
-			LinkAgainst $(1) : -L$(lpath) -l$(EDELIB_DBUS) -l$(EDELIB_GUI) -l$(EDELIB) $(DBUS_LIBS) ;
+			LinkAgainst $(target) : -L$(lpath) -l$(EDELIB_DBUS) -l$(EDELIB_GUI) -l$(EDELIB) $(DBUS_LIBS) ;
 		} else {
-			LinkAgainst $(1) : -L$(lpath) -l$(EDELIB_DBUS) -l$(EDELIB_GUI) -l$(EDELIB) ;
+			LinkAgainst $(target) : -L$(lpath) -l$(EDELIB_DBUS) -l$(EDELIB_GUI) -l$(EDELIB) ;
 		}
 	} else {
-		LinkAgainst $(1) : -L$(lpath) -l$(EDELIB_GUI) -l$(EDELIB) ;
+		LinkAgainst $(target) : -L$(lpath) -l$(EDELIB_GUI) -l$(EDELIB) ;
 	}
 
 	if $(3) {
-		LinkAgainst $(1) : $(3) ;
+		LinkAgainst $(target) : $(3) ;
 	}
 
-	LinkAgainst $(1) : $(STDLIB) $(DMALLOC_LIBC) $(DMALLOC_LIBCXX) ;
+	LinkAgainst $(target) : $(STDLIB) $(DMALLOC_LIBC) $(DMALLOC_LIBCXX) ;
 }
 
